{
  "name": "@leostera/clankwerk",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "clankwerk": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/cli.mjs",
    "src/index.ts",
    "src/graph",
    "template"
  ],
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.9.8",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
